# CashBridge environment template. Copy to .env (never commit .env).
# Leave LLM_API_KEY empty to run fully offline (deterministic fallback, "offline-demo" badge).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Demo-only TOTP secret (Base32). It is public on purpose so judges can approve L3 actions.
OTP_SECRET=JBSWY3DPEHPK3PXP

# UI backend: real (default) or stub
CASHBRIDGE_UI_BACKEND=real
